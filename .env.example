# Copy to .env and point RELEASE_DIR at the extracted reproducibility bundle
# (https://doi.org/10.5281/zenodo.18318139). Relative paths are resolved from the
# directory where `etf` is run (the repository root).
RELEASE_DIR=/ABS/PATH/TO/embryo-tempoformer_release_v1

# Optional Princeton S-BIAD840 bundle (https://doi.org/10.5281/zenodo.18979476).
SBIAD840_DIR=./data/sbiad840_aligned_4p5

# Outputs.
RUNS_DIR=./runs

# Everything below is optional.
# Individual paths override the bundle layout, e.g.
#   CKPT_FULL=/elsewhere/full_best.pt
#   PROC_28C5, PROC_25C, SPLIT_28C5, SPLIT_25C, CKPT_CNN_SINGLE, CKPT_MEANPOOL, CKPT_NOCONS,
#   PROC_28C5_SBIAD840, PROC_25C_SBIAD840, SPLIT_28C5_SBIAD840, SPLIT_25C_SBIAD840
# Raw Princeton PNG export (only for `etf sbiad840 preprocess`):
#   SBIAD840_SRC_ROOT=/ABS/PATH/TO/S-BIAD840/Files/Princeton_Data
# Runtime defaults:
#   DEVICE=auto   AMP=1   USE_EMA=1
# Interpreter used by scripts/reproduce_all.sh:
#   PYTHON_BIN=python3
# Protocol constants of the released models (change only for data recorded differently):
#   DT_H=0.25   T0_HPF=4.5   CLIP_LEN=24   STRIDE=8
